{
  "name": "@openthink/blind",
  "version": "0.4.0-rc.2",
  "description": "Make any document set blind to the identities you choose: analyst proposes, human approves, engine applies, auditor checks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenThinkAi/blind.git"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "blind": "bin/blind.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5"
  }
}
