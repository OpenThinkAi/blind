{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openthink.dev/blind/spec.schema.json",
  "title": "blind spec",
  "description": "What to blind and how. Written by the analyst, reviewed and edited by a human, applied by the engine. See docs/spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "columns", "entities", "patterns", "questions"],
  "properties": {
    "version": { "const": 1 },
    "columns": {
      "type": "array",
      "items": { "$ref": "#/$defs/column" }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person": { "$ref": "#/$defs/entityList" },
        "org": { "$ref": "#/$defs/entityList" },
        "host": { "$ref": "#/$defs/entityList" },
        "email": { "$ref": "#/$defs/entityList" },
        "id": { "$ref": "#/$defs/entityList" },
        "location": { "$ref": "#/$defs/entityList" },
        "vocabulary": { "$ref": "#/$defs/entityList" }
      }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "email", "host", "guid", "mac"],
      "properties": {
        "ip": { "type": "boolean" },
        "email": { "type": "boolean" },
        "host": { "type": "boolean" },
        "guid": { "type": "boolean" },
        "mac": { "type": "boolean" }
      }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "oneOf": [{ "required": ["header"] }, { "required": ["jsonPath"] }],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "sheet": { "$ref": "#/$defs/nonEmpty" },
        "header": { "type": "string" },
        "jsonPath": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "class", "treatment", "confidence", "source"],
      "oneOf": [{ "required": ["header"] }, { "required": ["jsonPath"] }],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "sheet": { "$ref": "#/$defs/nonEmpty" },
        "header": { "type": "string" },
        "jsonPath": { "$ref": "#/$defs/nonEmpty" },
        "class": {
          "enum": ["person", "org", "host", "email", "id", "location", "vocabulary", "unknown"]
        },
        "treatment": { "enum": ["blind", "keep", "value"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "enum": ["analyst", "human", "heuristic"] }
      }
    },
    "entityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "aliases", "parts"],
      "properties": {
        "canonical": { "$ref": "#/$defs/nonEmpty" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "options", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "options": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "answer": { "type": ["string", "null"] },
        "about": { "$ref": "#/$defs/location" }
      }
    }
  }
}
